<%@ Page Title="Profile" Language="C#"
MasterPageFile="~/Admin/AdminProfile.Master" AutoEventWireup="true"
CodeBehind="AdminPrivacy.aspx.cs" Inherits="StayBuddy.Admin.AdminPrivacy" %>
<asp:Content ContentPlaceHolderID="PanelContent" runat="server">
  <h3 class="ph">
    <a href="javascript:history.back()">&larr;</a> Privacy Policy
  </h3>
  <p>
    Welcome to <b>StayBuddy</b>. Your privacy is important to us. This Privacy
    Policy explains how we collect, use, and protect your information while
    using our application.
  </p>
  <b>1. Information We Collect:</b>
  <p>When you use StayBuddy, we may collect the following information:</p>
  <ul>
    <li>Personal: Full Name, Email Address, Mobile Number, Gender</li>
    <li>Account: Login credentials, Profile details</li>
    <li>
      Usage: Search preferences, Favourite stays, Pages visited within the
      application
    </li>
  </ul>
  <b>2. How We Use Your Information:</b>
  <ul>
    <li>Create and manage your account</li>
    <li>Display personalized stay listings</li>
    <li>Save your favourite stays</li>
    <li>Improve the application's performance and user experience</li>
    <li>Respond to queries and support requests</li>
    <li>Maintain platform security</li>
  </ul>
</asp:Content>