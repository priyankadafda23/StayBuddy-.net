<%@ Page Title="FAQ" Language="C#" MasterPageFile="~/ProfileMaster.Master"
AutoEventWireup="true" CodeBehind="Faq.aspx.cs" Inherits="StayBuddy.Faq" %>
<asp:Content ContentPlaceHolderID="PanelContent" runat="server">
  <h3 class="ph"><a href="javascript:history.back()">&larr;</a> FAQ</h3>
  <details class="faq">
    <summary>What is StayBuddy?</summary>
    <p>
      StayBuddy is a platform that helps students and working professionals find
      suitable PGs, hostels, and rental stays based on their preferences and
      location.
    </p>
  </details>
  <details class="faq">
    <summary>How can I search for a stay?</summary>
    <p>
      Go to the Search page and use filters such as area, gender, occupancy,
      room type, food and amenities.
    </p>
  </details>
  <details class="faq">
    <summary>How do I contact the stay owner?</summary>
    <p>
      Open the stay card to view the contact information provided by the
      property owner/administrator.
    </p>
  </details>
  <details class="faq">
    <summary>Can I edit my profile?</summary>
    <p>
      Yes, you can update your personal information and manage your account from
      the Profile page.
    </p>
  </details>
  <details class="faq">
    <summary>Can I book a stay through StayBuddy?</summary>
    <p>
      Currently, StayBuddy allows users to explore and compare accommodations.
      Online booking may be added in future updates.
    </p>
  </details>
  <details class="faq">
    <summary>Who can use StayBuddy?</summary>
    <p>
      StayBuddy is designed for students, working professionals, tenants and
      individuals relocating to a new city.
    </p>
  </details>
  <details class="faq">
    <summary>Still have questions?</summary>
    <p>
      Email: support@staybuddy.com | Support Hours: Monday - Saturday, 9:00 AM -
      6:00 PM
    </p>
  </details>
</asp:Content>